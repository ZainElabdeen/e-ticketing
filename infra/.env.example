# Copy to infra/.env (gitignored) before running docker compose:
#   cp infra/.env.example infra/.env
#
# The init script in infra/postgres/init only runs on an empty volume. After
# changing a password, recreate the volume:
#   docker compose -f infra/docker-compose.yml down -v
#
# Use URL-safe passwords (letters, digits, - _ . ~): the owner passwords are
# placed unencoded in the migration connection URLs.

POSTGRES_PASSWORD=change-me
TICKETS_OWNER_PASSWORD=change-me
TICKETS_APP_PASSWORD=change-me
PAYMENTS_OWNER_PASSWORD=change-me
PAYMENTS_APP_PASSWORD=change-me
LEDGER_OWNER_PASSWORD=change-me
LEDGER_APP_PASSWORD=change-me

# Ticket Service API keys: >= 32 chars, different from each other;
# generate with `openssl rand -hex 32` (hex has no `$`, which compose would interpolate).
# These are placeholders, not real keys.
PUBLIC_API_KEY_TICKET=replace-with-openssl-rand-hex-32-public
INTERNAL_API_KEY_TICKET=replace-with-openssl-rand-hex-32-internal

# Payment Service public key and the key the Payment Service sends to the
# Ledger Service (>= 32 chars; `openssl rand -hex 32`). Placeholders only.
PUBLIC_API_KEY_PAYMENT=replace-with-openssl-rand-hex-32-payment
INTERNAL_API_KEY_LEDGER=replace-with-openssl-rand-hex-32-ledger

# Ledger Service public key (held by the Gateway in Phase 6; used by the smoke
# test and contract suite). >= 32 chars, different from the internal key.
PUBLIC_API_KEY_LEDGER=replace-with-openssl-rand-hex-32-ledger-public

# Gateway (Phase 6). JWT signing secret: >= 32 bytes; `openssl rand -hex 32`. Placeholder only.
JWT_SECRET=replace-with-openssl-rand-hex-32-jwt
# Backoffice admin. Generate the hash with `node infra/scripts/admin-hash.mjs`
# (it prompts for the password); the value is base64 of a bcrypt cost-12 hash.
ADMIN_EMAIL=admin@eticketing.local
ADMIN_PASSWORD_HASH_B64=replace-with-output-of-admin-hash-mjs
# LOCAL DEV AND SMOKE ONLY: the plaintext admin password, read by the smoke test and
# the contract suite. Never set it in K3s or in CI secrets other than for the smoke run.
ADMIN_PASSWORD_DEV=replace-with-the-dev-admin-password
