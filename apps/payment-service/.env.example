# Copy to .env and replace every placeholder. Never commit .env.
PORT=3002
DATABASE_URL=postgresql://payments_app:change-me@localhost:5432/eticketing?schema=payments
PUBLIC_API_KEY_PAYMENT=change-me-public-key-at-least-32-chars
TICKET_SERVICE_URL=http://localhost:3001
LEDGER_SERVICE_URL=http://localhost:3003
# Sent to the Ticket and Ledger services; each at least 32 characters.
INTERNAL_API_KEY_TICKET=change-me-ticket-internal-key-at-least-32
INTERNAL_API_KEY_LEDGER=change-me-ledger-internal-key-at-least-32
DOWNSTREAM_TIMEOUT_MS=5000
SWAGGER_ENABLED=false
LOG_LEVEL=info
QR_SUCCESS_DELAY_SECONDS=8
QR_JOB_INTERVAL_SECONDS=1
QR_JOB_BATCH_SIZE=50
QR_JOB_ENABLED=true
OUTBOX_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_ENABLED=true
