{
  "name": "@eticket/payment-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync(require.resolve('@eticket/contracts/openapi/payment-service.json'),'dist/openapi.json')\"",
    "lint": "prisma generate && eslint .",
    "test": "prisma generate && jest -c jest.config.cjs",
    "test:int": "prisma generate && jest -c jest.int.config.cjs",
    "start": "node dist/src/main.js",
    "prisma:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@eticket/config": "workspace:*",
    "@eticket/contract-tests": "workspace:*",
    "@eticket/contracts": "workspace:*",
    "@eticket/testing": "workspace:*",
    "@nestjs/testing": "11.2.10",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@eticket/nest-common": "workspace:*",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "axios": "1.21.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
