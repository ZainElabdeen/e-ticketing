# Copy to .env and replace every placeholder. Never commit .env.
PORT=3001
DATABASE_URL=postgresql://tickets_app:change-me@localhost:5432/eticketing?schema=tickets
# Both keys: at least 32 characters, and they must differ.
PUBLIC_API_KEY_TICKET=change-me-public-key-at-least-32-chars
INTERNAL_API_KEY_TICKET=change-me-internal-key-at-least-32-chars
SWAGGER_ENABLED=false
LOG_LEVEL=info
ORDER_TTL_MINUTES=15
ORDER_EXPIRY_INTERVAL_SECONDS=60
ORDER_EXPIRY_BATCH_SIZE=100
ORDER_EXPIRY_ENABLED=true
