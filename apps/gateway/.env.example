# Copy to .env and replace every placeholder. Never commit .env.
PORT=3000
TICKET_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
LEDGER_SERVICE_URL=http://localhost:3003
# Public-scope keys the gateway sends; each at least 32 characters.
PUBLIC_API_KEY_TICKET=change-me-ticket-public-key-at-least-32
PUBLIC_API_KEY_PAYMENT=change-me-payment-public-key-at-least-32
PUBLIC_API_KEY_LEDGER=change-me-ledger-public-key-at-least-32
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
ADMIN_EMAIL=admin@example.com
# Base64 of a bcrypt cost-12 hash. Generate with: node infra/scripts/admin-hash.mjs
ADMIN_PASSWORD_HASH_B64=
WEB_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=false
LOG_LEVEL=info
DOWNSTREAM_TIMEOUT_MS=5000
TRUST_PROXY=0
RATE_LIMIT_DEFAULT_PER_MIN=100
RATE_LIMIT_ORDERS_PER_MIN=5
RATE_LIMIT_LOGIN_PER_MIN=10
