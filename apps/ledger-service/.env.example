# Copy to .env and replace every placeholder. Never commit .env.
PORT=3003
DATABASE_URL=postgresql://ledger_app:change-me@localhost:5432/eticketing?schema=ledger
# Held by the Gateway.
PUBLIC_API_KEY_LEDGER=change-me-ledger-public-key-at-least-32
# Held only by the Payment Service; must differ from the public key.
INTERNAL_API_KEY_LEDGER=change-me-ledger-internal-key-at-least-32
SWAGGER_ENABLED=false
LOG_LEVEL=info
