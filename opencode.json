{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/spec.md",
    "docs/adr/*.md",
    "apps/*/AGENTS.md",
    "packages/*/AGENTS.md",
    "infra/AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
